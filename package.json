{
  "name": "sapient-wallet",
  "version": "0.11.2",
  "description": "Sapient — a self-custody Chrome extension wallet for Tari Ootle (L2) — holds its own seed, signs and submits transactions directly to the network, no wallet daemon required.",
  "homepage": "https://chromewebstore.google.com/detail/tari-ootle-wallet/demkeckolenopkgnfbnpflkpbbdhpgkl",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "package": "vite build && node scripts/make-store-zip.mjs",
    "build:firefox": "vite build -c vite.firefox.config.ts",
    "package:firefox": "vite build -c vite.firefox.config.ts && node scripts/make-store-zip.mjs firefox",
    "lint:firefox": "addons-linter dist-firefox",
    "build:mobile": "vite build -c vite.mobile.config.ts",
    "android:sync": "vite build -c vite.mobile.config.ts && cap sync android",
    "android:apk": "vite build -c vite.mobile.config.ts && cap sync android && cd android && gradlew.bat assembleDebug",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:crypto": "vitest run src/lib/cryptoVectors.test.ts",
    "test:e2e": "playwright test",
    "check:release": "node scripts/check-release.mjs",
    "verify": "pnpm typecheck && pnpm test:coverage && pnpm package && pnpm package:firefox && pnpm lint:firefox && pnpm build:mobile && pnpm check:release && pnpm test:e2e",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@chironbuilder/ootle-sdk": "^0.6.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@reown/walletkit": "^1.6.0",
    "@tari-project/ootle": "^0.19.0",
    "@tari-project/ootle-indexer": "^0.19.0",
    "@tari-project/ootle-secret-key-wallet": "^0.19.0",
    "@tari-project/ootle-ts-bindings": "^1.66.0",
    "@tari-project/ootle-wallet-daemon-signer": "^0.19.0",
    "@tari-project/ootle-wasm": "^0.55.0",
    "@tari-project/ootle-wasm-bor": "^0.55.0",
    "@walletconnect/core": "^2.26.0",
    "@walletconnect/utils": "^2.26.0",
    "hash-wasm": "^4.12.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@chironbuilder/ootle-wasm-legacy": "file:vendor/ootle-wasm-patched",
    "@crxjs/vite-plugin": "^2.7.1",
    "@noble/curves": "^2.4.0",
    "@playwright/test": "1.65.1",
    "@swc/core": "1.15.46",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "addons-linter": "^10.16.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "8.1.7",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.33",
    "nanoid@3": "^3.3.18",
    "source-map-js": "^1.2.2"
  }
}
