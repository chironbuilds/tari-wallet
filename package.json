{
  "name": "sapient-wallet",
  "version": "0.4.1",
  "description": "Sapient — a self-custody Chrome extension wallet for Tari Ootle (L2) — holds its own seed, signs and submits transactions directly to the network, no wallet daemon required.",
  "homepage": "https://chromewebstore.google.com/detail/tari-ootle-wallet/demkeckolenopkgnfbnpflkpbbdhpgkl",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:crypto": "tsx scripts/test-crypto.ts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@tari-project/ootle": "^0.3.0",
    "@tari-project/ootle-indexer": "^0.3.0",
    "@tari-project/ootle-secret-key-wallet": "^0.3.0",
    "@tari-project/ootle-ts-bindings": "^1.49.1",
    "@tari-project/ootle-wallet-daemon-signer": "^0.3.0",
    "@tari-project/ootle-wasm": "^0.39.1",
    "hash-wasm": "^4.12.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  }
}
